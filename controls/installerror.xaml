<controls:UserControl
	x:Class="BlueStacks.Installer.InstallError" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:BlueStacks.Installer" xmlns:Common="clr-namespace:BlueStacks.Common;assembly=HD-Common" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
	DataContext="{Binding Source={x:Static Common:BlueStacksUIBinding.Instance}}"
	Background="{Binding Path=ColorModel.[InstallerWindowBackground]}">
	<FrameworkElement.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/HD-Common;component/Resources/ButtonResource.xaml" />
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="1*" />
			<ColumnDefinition
				Width="5.3*" />
			<ColumnDefinition
				Width="2.2*" />
		</Grid.ColumnDefinitions>
		<Common:CustomPictureBox
			Grid.Column="0"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Margin="15"
			ImageName="error_icon" />
		<StackPanel
			Name="mInstallErrorGrid"
			Grid.Column="1"
			Visibility="Visible">
			<Label
				Name="mInstallErrorCode"
				FontSize="16"
				FontWeight="Bold"
				Margin="0,5,0,0"
				Content="{Binding Path=LocaleModel.[STRING_INSTALLATION_ERROR], FallbackValue=Installation Error}"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
			<TextBlock
				FontSize="14"
				Margin="5,0,0,0"
				TextWrapping="WrapWithOverflow"
				Text="{Binding Path=LocaleModel.[STRING_TRY_RESTARTING_MACHINE], FallbackValue=Try restarting your computer &amp; install again}"
				Foreground="{Binding Path=ColorModel.[InstallerWindowLightTextForeground]}" />
		</StackPanel>
		<StackPanel
			Name="mPreInstallErrorGrid"
			Visibility="Hidden"
			Width="500"
			Grid.Column="1"
			VerticalAlignment="Top">
			<Label
				Name="mSystemRequirementNotMetLabel"
				FontSize="14"
				FontWeight="Bold"
				Content="{Binding Path=LocaleModel.[STRING_SYSTEM_REQUIREMENTS_NOT_MET], FallbackValue=Minimum system requirements not met}"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
			<TextBlock
				Name="mPreInstallReason1"
				Visibility="Hidden"
				TextWrapping="Wrap"
				TextTrimming="WordEllipsis"
				FontSize="12"
				MaxHeight="40"
				Margin="5,0,0,0"
				Foreground="{Binding Path=ColorModel.[InstallerWindowLightTextForeground]}"
				Text="{Binding Path=LocaleModel.[STRING_TRY_RESTARTING_MACHINE], FallbackValue=Try restarting your computer &amp; install again}" />
			<TextBlock
				Name="mPreInstallReason2"
				Margin="5,0,0,0"
				Visibility="Hidden"
				TextWrapping="Wrap"
				FontSize="12"
				MaxHeight="40"
				TextTrimming="WordEllipsis"
				Foreground="{Binding Path=ColorModel.[InstallerWindowLightTextForeground]}"
				Text="{Binding Path=LocaleModel.[STRING_TRY_RESTARTING_MACHINE], FallbackValue=Try restarting your computer &amp; install again}" />
		</StackPanel>
		<Button
			Name="mRestartNowButton"
			Grid.Column="2"
			Style="{StaticResource MaterialDesignButton}"
			Visibility="Visible"
			Content="{Binding Path=LocaleModel.[STRING_RESTART_NOW], FallbackValue=Restart Now}" />
	</Grid>
</controls:UserControl>
