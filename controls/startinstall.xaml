<controls:UserControl
	x:Class="BlueStacks.Installer.StartInstall" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:BlueStacks.Installer" xmlns:Common="clr-namespace:BlueStacks.Common;assembly=HD-Common" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
	DataContext="{Binding Source={x:Static Common:BlueStacksUIBinding.Instance}}"
	Background="{Binding Path=ColorModel.[InstallerWindowBackground]}">
	<FrameworkElement.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/HD-Common;component/Resources/ButtonResource.xaml" />
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Button
			Name="mInstallNowButton"
			Grid.Column="1"
			Style="{StaticResource MaterialDesignButtonPink}"
			MaxHeight="49"
			IsEnabled="False"
			Content="{Binding Path=LocaleModel.[STRING_INSTALL_NOW], FallbackValue=Install Now}" />
		<StackPanel
			Name="mCustomInstallLicensePanel"
			Grid.Column="2"
			Orientation="Vertical"
			HorizontalAlignment="Right"
			Margin="0,8,0,8">
			<StackPanel
				Orientation="Horizontal"
				HorizontalAlignment="Right">
				<Common:CustomPictureBox
					Name="mCustomInstallImage"
					ImageName="custom" />
				<Label
					Name="mCustomInstallLabel"
					FontSize="12"
					Padding="2"
					Margin="0,0,10,0"
					Content="{Binding Path=LocaleModel.[STRING_CUSTOM], FallbackValue=Custom Install}">
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type Label}">
							<Setter
								Property="Foreground"
								Value="{Binding Path=ColorModel.[InstallerWindowTextForeground]}" />
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="Foreground"
										Value="{Binding Path=ColorModel.[InstallerWindowMouseOverTextForeground]}" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Label>
			</StackPanel>
			<StackPanel
				Orientation="Horizontal"
				HorizontalAlignment="Right"
				MaxHeight="25">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type TextBlock}"
							x:Key="{x:Type TextBlock}">
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="Foreground"
										Value="{Binding Path=ColorModel.[InstallerWindowMouseOverTextForeground]}" />
									<Setter
										Property="FrameworkElement.Cursor"
										Value="Hand" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<Common:TextWrapCustomCheckBox
					Name="mAgreeCheckBox"
					Height="20"
					IsChecked="True"
					FontSize="12"
					Padding="2,2,2,2"
					CheckBoxTextBlockForeground="{Binding Path=ColorModel.[InstallerTextForeground]}"
					CheckBoxTextBlockText="{Binding Path=LocaleModel.[STRING_AGREE], FallbackValue=Agree}" />
				<Label
					FontSize="12"
					Padding="2"
					Margin="0,0,10,0"
					Foreground="{Binding Path=ColorModel.[InstallerTextForeground]}"
					MouseDown="SoftwareLincenceMouseDown">
					<TextBlock
						Text="{Binding Path=LocaleModel.[STRING_SOFTWARE_LICENSE], FallbackValue=software license}" />
				</Label>
			</StackPanel>
			<Common:TextWrapCustomCheckBox
				Name="mReceiveCheckBox"
				Height="20"
				IsChecked="False"
				Visibility="Collapsed"
				HorizontalAlignment="Right"
				Margin="0,0,10,0"
				FontSize="12"
				Padding="2,2,2,2"
				CheckBoxTextBlockForeground="{Binding Path=ColorModel.[InstallerTextForeground]}"
				CheckBoxTextBlockText="{Binding Path=LocaleModel.[STRING_RECEIVE_EMAIL_NOTIFICATION], FallbackValue=Receive email notifications}" />
		</StackPanel>
	</Grid>
</controls:UserControl>
