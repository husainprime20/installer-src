<controls:UserControl
	x:Class="BlueStacks.Installer.InstallProgress" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:BlueStacks.Installer" xmlns:Common="clr-namespace:BlueStacks.Common;assembly=HD-Common" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
	DataContext="{Binding Source={x:Static Common:BlueStacksUIBinding.Instance}}"
	Background="{Binding Path=ColorModel.[InstallerWindowBackground]}">
	<FrameworkElement.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/HD-Common;component/Resources/ButtonResource.xaml" />
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="2.5*" />
			<ColumnDefinition
				Width="5*" />
			<ColumnDefinition
				Width="2.5*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="5" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid
			Name="mProgressGrid"
			HorizontalAlignment="Stretch"
			Column="1"
			ColumnSpan="2"
			Row="0"
			Margin="0,5,20,0">
			<Label
				Name="mInstallProgressStatus"
				HorizontalAlignment="Left"
				Content="Install begins"
				HorizontalContentAlignment="Left"
				Margin="-6,0,0,0"
				FontSize="14"
				FontWeight="SemiBold"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
			<Label
				Name="mInstallProgressPercentage"
				HorizontalAlignment="Right"
				HorizontalContentAlignment="Right"
				Content="20%"
				FontSize="14"
				Margin="0,0,-6,0"
				FontWeight="SemiBold"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
		</Grid>
		<ProgressBar
			Name="mInstallProgressBar"
			Grid.Column="1"
			Grid.ColumnSpan="2"
			Grid.Row="1"
			Style="{StaticResource ProgressBarStyle}"
			Height="5"
			Value="20"
			Margin="0,0,20,0" />
		<Grid
			Name="mTipsGrid"
			HorizontalAlignment="Stretch"
			Column="1"
			ColumnSpan="2"
			Row="3">
			<Common:CustomTextBlock
				Name="mInstallTips"
				HorizontalAlignment="Left"
				Text="Tips"
				FontSize="12"
				Margin="0, -5, 15, 0"
				TextTrimming="CharacterEllipsis"
				Foreground="{Binding Path=ColorModel.[InstallerSecondaryProgressTextColor]}" />
		</Grid>
	</Grid>
</controls:UserControl>
