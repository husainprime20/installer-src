<UserControl
	x:Class="BlueStacks.Installer.ChooseInstallFolder" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:BlueStacks.Installer" xmlns:Common="clr-namespace:BlueStacks.Common;assembly=HD-Common"
	DataContext="{Binding Source={x:Static Common:BlueStacksUIBinding.Instance}}"
	Background="{Binding Path=ColorModel.[InstallerWindowBackground]}">
	<FrameworkElement.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/HD-Common;component/Resources/ButtonResource.xaml" />
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="2.5*" />
			<ColumnDefinition
				Width="5*" />
			<ColumnDefinition
				Width="2.5*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height=".9*" />
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height=".9*" />
		</Grid.RowDefinitions>
		<Label
			Grid.Row="0"
			Grid.Column="1"
			Margin="3,0,0,0"
			FontSize="12"
			Content="{Binding Path=LocaleModel.[STRING_DATA_PATH], FallbackValue=BlueStacks Data Path}"
			Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
		<StackPanel
			Orientation="Horizontal"
			Grid.Row="1"
			Grid.Column="1"
			VerticalAlignment="Center">
			<Common:CustomTextBox
				Name="mBluestacksDataLocation"
				Margin="5,5,0,5"
				VerticalAlignment="Center"
				HorizontalContentAlignment="Left"
				Grid.Column="0"
				IsReadOnly="True"
				Width="200"
				FontSize="12" />
			<Common:CustomPictureBox
				Name="mChooseFolderButton"
				Margin="5,0,0,1"
				ImageName="setpath"
				Height="15"
				Width="15"
				VerticalAlignment="Center" />
			<Label
				Name="mChooseFolderLabel"
				Margin="5,0,0,1"
				VerticalAlignment="Center"
				FontSize="12"
				Content="{Binding Path=LocaleModel.[STRING_CHANGE_FOLDER], FallbackValue=Change folder}"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Label}">
						<Setter
							Property="Foreground"
							Value="{Binding Path=ColorModel.[InstallerWindowTextForeground]}" />
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="Foreground"
									Value="{Binding Path=ColorModel.[InstallerWindowMouseOverTextForeground]}" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Label>
		</StackPanel>
		<StackPanel
			Grid.Column="1"
			Grid.Row="2"
			Orientation="Horizontal"
			Margin="0,0,0,0"
			VerticalAlignment="Top">
			<Label
				FontSize="12"
				Content="{Binding Path=LocaleModel.[STRING_SPACE_REQUIRED], FallbackValue=Space Required}"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
			<Label
				Content="2048MB"
				FontSize="12"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
			<Label
				HorizontalAlignment="Right"
				FontSize="12"
				Content="{Binding Path=LocaleModel.[STRING_SPACE_AVAILABLE], FallbackValue=Space Available}"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
			<Label
				Name="mSpaceAvailable"
				HorizontalAlignment="Right"
				FontSize="12"
				Foreground="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
		</StackPanel>
		<StackPanel
			Grid.ColumnSpan="2"
			Grid.Row="0"
			Grid.RowSpan="3"
			Orientation="Vertical"
			Grid.Column="2"
			HorizontalAlignment="Right"
			Margin="10">
			<StackPanel
				Grid.Column="2"
				Orientation="Vertical"
				VerticalAlignment="Top"
				HorizontalAlignment="Right"
				Height="81.316">
				<StackPanel
					Orientation="Horizontal"
					VerticalAlignment="Center"
					Margin="0,10,10,0">
					<Common:CustomPictureBox
						Name="mInstallNowButton"
						Panel.ZIndex="4"
						ImageName="custom"
						Height="15"
						Width="15"
						VerticalAlignment="Center" />
					<Label
						Name="mInstallNowLabel"
						MaxWidth="122"
						MaxHeight="25"
						FontSize="12"
						Margin="5,0,0,0"
						Content="{Binding Path=LocaleModel.[STRING_INSTALL_NOW], FallbackValue=Install Now}">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Label}">
								<Setter
									Property="Foreground"
									Value="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="Foreground"
											Value="{Binding Path=ColorModel.[InstallerWindowTextForeground]}" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Label>
				</StackPanel>
				<StackPanel
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					Margin="0,0,15,15">
					<Common:CustomPictureBox
						Name="mBackButton"
						ImageName="backicon"
						Height="10"
						Width="10"
						VerticalAlignment="Center" />
					<Label
						Name="mBackButtonLabel"
						FontSize="12"
						HorizontalAlignment="Right"
						Margin="5,0,0,0"
						Content="{Binding Path=LocaleModel.[STRING_BACK], FallbackValue=Back}">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Label}">
								<Setter
									Property="Foreground"
									Value="{Binding Path=ColorModel.[InstallerWindowWhiteTextColor]}" />
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="Foreground"
											Value="{Binding Path=ColorModel.[InstallerWindowTextForeground]}" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Label>
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</Grid>
</UserControl>
