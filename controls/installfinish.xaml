<controls:UserControl
	x:Class="BlueStacks.Installer.InstallFinish" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:BlueStacks.Installer" xmlns:Common="clr-namespace:BlueStacks.Common;assembly=HD-Common" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
	Background="{Binding Path=ColorModel.[InstallerWindowBackground]}"
	DataContext="{Binding Source={x:Static Common:BlueStacksUIBinding.Instance}}">
	<FrameworkElement.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/HD-Common;component/Resources/ButtonResource.xaml" />
	</FrameworkElement.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="2.5*" />
			<ColumnDefinition
				Width="5*" />
			<ColumnDefinition
				Width="2.5*" />
		</Grid.ColumnDefinitions>
		<Button
			Name="mLaunchBlueStacks"
			Grid.Column="1"
			Style="{StaticResource MaterialDesignButtonPink}"
			MinWidth="120"
			Content="{Binding Path=LocaleModel.[STRING_LAUNCH], FallbackValue=Launch}" />
		<Grid
			Column="2"
			VerticalAlignment="Center">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="10" />
			</Grid.ColumnDefinitions>
			<StackPanel
				Orientation="Vertical">
				<Common:TextWrapCustomCheckBox
					Name="mLaunchBSCheckBox"
					Height="23"
					MaxHeight="16"
					Margin="0,2,0,0"
					HorizontalAlignment="Right"
					FontSize="11"
					IsChecked="True"
					CheckBoxTextBlockForeground="{Binding Path=ColorModel.[InstallerWindowLightTextForeground]}">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<Style
								TargetType="{x:Type TextBlock}"
								x:Key="{x:Type TextBlock}">
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="Foreground"
											Value="{Binding Path=ColorModel.[MaterialDesignBlueBtnBackground]}" />
										<Setter
											Property="FrameworkElement.Cursor"
											Value="Hand" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</Common:TextWrapCustomCheckBox>
				<Label
					Name="mInstallDoneText"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Margin="0,5"
					Padding="0"
					Content="{Binding Path=LocaleModel.[STRING_INSTALL_DONE], FallbackValue=Install Done}"
					Foreground="{Binding Path=ColorModel.[InstallerTextForeground]}" />
			</StackPanel>
		</Grid>
	</Grid>
</controls:UserControl>
